{
  "name": "dsh-conversation-lock",
  "version": "0.1.0",
  "private": true,
  "description": "Per-conversation lock that decides whether other agents may deliver messages into a session, with an in-conversation unlock control",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kzhw615/dsh-conversation-lock.git"
  },
  "homepage": "https://github.com/kzhw615/dsh-conversation-lock#readme",
  "bugs": {
    "url": "https://github.com/kzhw615/dsh-conversation-lock/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent-collaboration",
    "conversation-lock"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.2"
  },
  "scripts": {
    "test": "node --test test/host.test.mjs",
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
